@echo off
chcp 65001 >nul
title Conector WhatsApp - Consultorio Dr. Cortalezzi (Eleven Med)
color 0B

echo ====================================================================
echo    CORTALEZZI VISION / ELEVEN MED - VINCULADOR DE WHATSAPP (PC)
echo ====================================================================
echo.

set "SELF_BAT=%~f0"
set "CURRENT_DIR=%~dp0"

:: Si se abrio directo desde adentro de un .ZIP (carpeta Temp) o suelto sin server.js,
:: instalar automaticamente en carpeta permanente C:\Users\<Usuario>\ElevenMed_WhatsApp
echo "%CURRENT_DIR%" | find /I "\Temp\" >nul
if "%ERRORLEVEL%"=="0" (
    set "SERVICE_DIR=%USERPROFILE%\ElevenMed_WhatsApp"
) else (
    if exist "%CURRENT_DIR%server.js" (
        set "SERVICE_DIR=%CURRENT_DIR%"
    ) else if exist "%CURRENT_DIR%whatsapp-service\server.js" (
        set "SERVICE_DIR=%CURRENT_DIR%whatsapp-service"
    ) else (
        set "SERVICE_DIR=%USERPROFILE%\ElevenMed_WhatsApp"
    )
)

if not exist "%SERVICE_DIR%" mkdir "%SERVICE_DIR%"

:: Extraer siempre server.js, package.json y .env desde este mismo archivo .BAT
if not exist "%SERVICE_DIR%\server.js" (
    echo [0/3] Preparando archivos del conector en "%SERVICE_DIR%"...
    powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=[IO.File]::ReadAllText($env:SELF_BAT); foreach($p in @(@('PKG','package.json'),@('ENV','.env'),@('SRV','server.js'))){ $pat='(?m)^::B64_'+$p[0]+'_START\r?\n([\s\S]+?)\r?\n::B64_'+$p[0]+'_END'; if($b -match $pat){ [IO.File]::WriteAllBytes((Join-Path $env:SERVICE_DIR $p[1]),[Convert]::FromBase64String(($Matches[1] -replace '\s',''))) } }; Copy-Item -LiteralPath $env:SELF_BAT -Destination (Join-Path $env:SERVICE_DIR 'Vincular_WhatsApp_Consultorio.bat') -Force"
)

if /I "%1"=="--extract-only" exit /b 0

if not exist "%SERVICE_DIR%\server.js" (
    color 0C
    echo [ERROR] No se pudieron preparar los archivos en "%SERVICE_DIR%".
    pause
    exit /b 1
)

cd /d "%SERVICE_DIR%"

:: Verificar si Node.js esta instalado
where node >nul 2>nul
if "%ERRORLEVEL%" NEQ "0" (
    if exist "%ProgramFiles%\nodejs\node.exe" (
        set "PATH=%ProgramFiles%\nodejs;%PATH%"
    )
)

where node >nul 2>nul
if "%ERRORLEVEL%" NEQ "0" (
    color 0E
    echo [AVISO] Node.js no esta instalado todavia en esta PC.
    echo Intentando instalar Node.js LTS automaticamente con Windows Winget...
    echo.
    winget install OpenJS.NodeJS.LTS --accept-package-agreements --accept-source-agreements --silent
    if exist "%ProgramFiles%\nodejs\node.exe" (
        set "PATH=%ProgramFiles%\nodejs;%PATH%"
    )
)

where node >nul 2>nul
if "%ERRORLEVEL%" NEQ "0" (
    color 0C
    echo.
    echo ====================================================================
    echo  ATENCION: Esta PC necesita instalar Node.js ^(1 minuto por unica vez^).
    echo  Se abrira la pagina oficial https://nodejs.org/es
    echo  Descargue el boton verde "Descargar Node.js (LTS)", instalelo con
    echo  "Next -> Next -> Install" y vuelva a abrir este archivo .BAT.
    echo ====================================================================
    start "" "https://nodejs.org/es"
    echo.
    pause
    exit /b 1
)

:: Instalar dependencias automaticamente la primera vez
if not exist "%SERVICE_DIR%\node_modules\@whiskeysockets\baileys" (
    echo [1/2] Descargando componentes de WhatsApp por primera vez ^(aguarde 30 a 60 seg^)...
    call npm install --no-audit --no-fund
    if "%ERRORLEVEL%" NEQ "0" (
        color 0C
        echo [ERROR] Hubo un inconveniente descargando dependencias. Verifique su conexion a Internet.
        pause
        exit /b 1
    )
)

:: Configurar inicio automatico en Windows para proximos reinicios
set "STARTUP_LNK=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\WhatsApp_ElevenMed.lnk"
if not exist "%STARTUP_LNK%" (
    powershell -NoProfile -ExecutionPolicy Bypass -Command "$ws=New-Object -ComObject WScript.Shell; $s=$ws.CreateShortcut($env:STARTUP_LNK); $s.TargetPath=(Join-Path $env:SERVICE_DIR 'Vincular_WhatsApp_Consultorio.bat'); $s.Arguments='--silent'; $s.WorkingDirectory=$env:SERVICE_DIR; $s.WindowStyle=7; $s.Save()" >nul 2>nul
)

set "PORT=3001"
if "%CLOUD_URL%"=="" set "CLOUD_URL=https://elevenmed.elevensistemas.com"
if "%API_KEY%"=="" set "API_KEY=eleven_med_secret_wa_key_2026"

echo.
echo [2/2] Conectando en vivo con %CLOUD_URL% ...
echo       Carpeta activa: %SERVICE_DIR%
echo       ^(Mantenga esta ventana minimizada mientras use WhatsApp en el consultorio^)
echo.

if /I not "%1"=="--silent" (
    start "" cmd /c "timeout /t 3 /nobreak >nul && start http://127.0.0.1:3001/vincular"
)

:loop
node server.js
echo.
echo [AVISO] Reconectando automaticamente en 5 segundos...
timeout /t 5 /nobreak >nul
goto loop
exit /b 0
